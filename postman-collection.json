    {
      "name": "6. Agendas",
      "item": [
        {
          "name": "Cadastrar Agenda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospitalId\": \"{{hospitalId}}\",\n  \"horarios\": [\n    {\n      \"diaSemana\": \"MONDAY\",\n      \"horario\": \"09:00:00\"\n    },\n    {\n      \"diaSemana\": \"MONDAY\",\n      \"horario\": \"10:00:00\"\n    },\n    {\n      \"diaSemana\": \"TUESDAY\",\n      \"horario\": \"09:00:00\"\n    },\n    {\n      \"diaSemana\": \"TUESDAY\",\n      \"horario\": \"10:00:00\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/agendas",
              "host": ["{{baseUrl}}"],
              "path": ["agendas"]
            },
            "description": "Cadastra uma nova agenda para um médico (requer autenticação)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"agendaId\", jsonData.id);",
                  "if (jsonData.horarios && jsonData.horarios.length > 0) {",
                  "  pm.collectionVariables.set(\"horarioId\", jsonData.horarios[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
